generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
  EMAIL_CHANGE_UNDO
}

enum VerificationStatus {
  NONE
  EDEVLET_VERIFIED
}

enum DmPolicy {
  EVERYONE
  FRIENDS
  NONE
}

enum MediaPolicy {
  EVERYONE
  FRIENDS
  NONE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// C9 — 1-1 DM mesaj isteği durumu (yalnız type=DM için anlamlı).
// null = normal/legacy kanal (geriye uyum: mevcut tüm DM'ler kabul edilmiş sayılır).
enum DmRequestStatus {
  PENDING
  ACCEPTED
}

enum GuildRole {
  OWNER
  MEMBER
}

enum ChannelType {
  GUILD_TEXT
  GUILD_VOICE
  DM
  GROUP_DM
}

enum ScanStatus {
  PENDING
  CLEAN
  FLAGGED
}

enum EventLocationType {
  VOICE_CHANNEL
  EXTERNAL
}

enum EventRecurrence {
  NONE // MVP — yalnız bu kullanılır
  DAILY
  WEEKLY
  MONTHLY
}

enum EventStatus {
  SCHEDULED // MVP varsayılan
  ACTIVE
  COMPLETED
  CANCELED
}

enum NotificationType {
  MENTION
  FRIEND_REQUEST
  FRIEND_ACCEPT
  GUILD_INVITE
  EVENT_CREATED // R14 — ortamda yeni etkinlik oluşturuldu
  REACTION // C46 — mesajına tepki bırakıldı (ortam: çan kaydı + push; DM: yalnız push)
  AI_VIDEO_READY // C49 — yapay zeka video arka planda tamamlandı
  AI_VIDEO_FAILED // C49 — yapay zeka video arka planda başarısız oldu (kredi düşülmedi)
  E2EE_TRANSFER // E5b — şifreli mesaj geçmişi yeni bir cihaza aktarıldı (güvenlik bildirimi, kapatılamaz)
}

enum NotificationLevel {
  ALL
  MENTIONS
  NONE
}

enum NotifTargetType {
  GUILD
  CHANNEL
}

model User {
  id                     String                @id @default(cuid())
  username               String                @unique
  email                  String                @unique
  passwordHash           String
  birthDate              DateTime
  isMinor                Boolean
  isModerator            Boolean               @default(false)
  verificationStatus     VerificationStatus    @default(NONE)
  dmPolicy               DmPolicy              @default(FRIENDS)
  mediaPolicy            MediaPolicy           @default(FRIENDS)
  profileDiscoverable    Boolean               @default(true)
  readReceipts           Boolean               @default(true) // C12: okundu bilgisi paylaşımı (karşılıklı, sözleşme §2)
  reactionNotifications  Boolean               @default(true) // C46: mesajıma bırakılan tepki bildirimi (varsayılan açık)
  quickReactions         String[]              @default([]) // C24: hızlı tepki şeridi; boş = varsayılan beşli
  showGameActivity       Boolean? // C31b §2: "Oynadığım oyunu göster". null = yaşa göre varsayılan (yetişkin açık, minör kapalı)
  showRecentActivity     Boolean               @default(false) // C31f: "Son oynadığım oyunlar" (7 gün saklanır). Varsayılan KAPALI; minör asla true olamaz
  emailVerifiedAt        DateTime?
  avatarUrl              String?
  bio                    String?
  bannerColor            String? // profil afiş rengi (preset anahtar; allowlist).
  bannerUrl              String? // C8: profil afişi görseli (public URL; ikon deseni)
  avatarAnimatedUrl      String? // C13: hareketli WebP avatar (avatarUrl = aynı işlemin statik karesi)
  bannerAnimatedUrl      String? // C13: hareketli WebP profil afişi (bannerUrl = statik kare)
  deletedAt              DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  twoFactorEnabled       Boolean               @default(false)
  totpSecret             String?
  deletionRequestedAt    DateTime?
  friendCode             String                @unique
  // Platform davet sistemi (kapalı-kayıt fazı — Sprint Closed-Registration)
  platformInviteId       String? // hangi davetle kaydoldu (audit / güven grafiği); null = open-mode kaydı
  platformInvite         PlatformInvite?       @relation("RedeemedPlatformInvite", fields: [platformInviteId], references: [id])
  createdPlatformInvites PlatformInvite[]      @relation("PlatformInviteCreator")
  sessions               Session[]
  e2eeDevices            E2eeDevice[]
  e2eeBackup             E2eeBackup?
  memberships            GuildMember[]
  ownedGuilds            Guild[]               @relation("GuildOwner")
  messages               Message[]
  authTokens             AuthToken[]
  recoveryCodes          RecoveryCode[]
  friendshipsSent        Friendship[]          @relation("FriendRequester")
  friendshipsReceived    Friendship[]          @relation("FriendAddressee")
  blocksMade             UserBlock[]           @relation("Blocker")
  blocksReceived         UserBlock[]           @relation("Blocked")
  channelMemberships     ChannelMember[]
  ownedChannels          Channel[]             @relation("ChannelOwner")
  dmRequestChannels      Channel[]             @relation("DmRequester") // C9: başlattığı mesaj isteği kanalları
  createdInvites         Invite[]              @relation("InviteCreator")
  attachments            Attachment[]
  reportsFiled           Report[]              @relation("Reporter")
  reportResolutions      Report[]              @relation("ReportResolver")
  moderationActions      ModerationAction[]    @relation("ModeratorActions")
  moderationTargets      ModerationAction[]    @relation("ModerationTargets")
  auditLogs              AuditLog[]            @relation("AuditActor")
  channelReads           ChannelRead[]
  voiceSessions          VoiceSession[]
  createdEvents          GuildEvent[]          @relation("EventCreator")
  eventInterests         GuildEventInterest[]
  notifications          Notification[]        @relation("UserNotifications")
  notificationsActed     Notification[]        @relation("NotificationActor")
  notificationPrefs      NotificationPref[]    @relation("UserNotificationPrefs")
  pushTokens             PushToken[]
  recentGames            RecentGame[]
  aiVideoGenerations     AiVideoGeneration[]
  aiVideoGrant           AiVideoGrant?         @relation("AiVideoGrantUser")
  aiVideoGrantsGiven     AiVideoGrant[]        @relation("AiVideoGrantBy")
  webhooksCreated        Webhook[]
  externalAccounts       ExternalAccount[]
  streamAnnounceOptIns   StreamAnnounceOptIn[]
}

enum GameSource {
  STEAM
  EPIC
  CURATED
}

// C31b §1: oyun algılama tablosu. Ad HİÇBİR ZAMAN istemciden alınmaz (Steam: sunucu mağazadan çeker,
// Epic: ilk kayıtta automod süzgecinden geçen ad kilitlenir, CURATED: migration seed'i).
model Game {
  id          String       @id @default(cuid())
  name        String
  source      GameSource
  externalId  String? // STEAM: appid · EPIC: catalogItemId · CURATED: slug
  executables String[]     @default([]) // yalnız CURATED: masaüstü eşleme için küçük harf süreç adları
  hidden      Boolean      @default(false) // admin kaldırdı: yayılmaz, tekrar eklenmez
  iconUrl     String? // C31c: sunucunun Steam'den alıp 64x64 WebP yaptığı kendi (cdn) adresimiz
  createdAt   DateTime     @default(now())
  recentGames RecentGame[]

  @@unique([source, externalId])
}

/// C31f: son oynanan oyun. Oturum/süre günlüğü DEĞİL: kişi başına oyun başına yalnız son oynama anı (upsert).
/// 7 günden eski satır günlük job ile silinir; ayar kapanınca ve hesap imhasında hemen silinir.
model RecentGame {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId       String
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  lastPlayedAt DateTime

  @@unique([userId, gameId])
  @@index([lastPlayedAt])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  type      AuthTokenType
  tokenHash String
  payload   String? // EMAIL_CHANGE: hedef e-posta; EMAIL_CHANGE_UNDO: eski e-posta
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
  @@index([tokenHash])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  refreshTokenHash String
  tokenFamily      String
  device           String?
  ip               String?
  clientType       String? // 'mobile' | null (=web/desktop, geriye dönük uyum) — M0 bearer refresh teslimi
  lastActiveAt     DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model Guild {
  id                String            @id @default(cuid())
  name              String
  ownerId           String
  owner             User              @relation("GuildOwner", fields: [ownerId], references: [id])
  adultsOnly        Boolean           @default(false)
  iconUrl           String?
  iconAnimatedUrl   String? // C19: hareketli simge (WebP); iconUrl daima statik kare kalır
  description       String?
  discoverable      Boolean           @default(false) // C6: Keşfet opt-in (default kapalı)
  tags              String[]          @default([]) // C6: ilgi etiketleri (max 5; servis doğrular)
  bannerColor       String? // C6: preset renk anahtarı (allowlist; görsel değil)
  bannerUrl         String? // C8: ortam afişi görseli (public URL; ikon deseni)
  bannerAnimatedUrl String? // C19: hareketli afiş (WebP); bannerUrl daima statik kare kalır
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  members           GuildMember[]
  channels          Channel[]
  invites           Invite[]
  categories        ChannelCategory[]
  bans              GuildBan[]
  roles             Role[]
  events            GuildEvent[]

  @@index([discoverable])
}

model GuildMember {
  id        String            @id @default(cuid())
  guildId   String
  guild     Guild             @relation(fields: [guildId], references: [id])
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  role      GuildRole         @default(MEMBER)
  joinedAt  DateTime          @default(now())
  roleLinks GuildMemberRole[]

  @@unique([guildId, userId])
  @@index([userId])
}

model Role {
  id           String            @id @default(cuid())
  guildId      String
  guild        Guild             @relation(fields: [guildId], references: [id])
  name         String
  color        String            @default("#99AAB5")
  position     Int               @default(0)
  hoist        Boolean           @default(false)
  mentionable  Boolean           @default(false)
  permissions  String[]          @default([])
  iconUrl      String?
  unicodeEmoji String? // C21: tek emoji, yalnız görünüm
  isEveryone   Boolean           @default(false)
  isDefault    Boolean           @default(false) // yeni katılan üyelere otomatik atanır (guild başına tek)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  memberLinks  GuildMemberRole[]

  @@index([guildId])
}

model GuildMemberRole {
  id         String      @id @default(cuid())
  memberId   String
  member     GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime    @default(now())

  @@unique([memberId, roleId])
  @@index([roleId])
}

// Ortam-ban: kalıcı yasak (kick + tekrar davetle giremez). Davet-join'de kontrol edilir.
// userId/bannedById Prisma ilişkisi değil (User şemasını şişirmemek için); username ayrı sorgulanır.
model GuildBan {
  id         String   @id @default(cuid())
  guildId    String
  guild      Guild    @relation(fields: [guildId], references: [id])
  userId     String
  bannedById String
  reason     String?
  createdAt  DateTime @default(now())

  @@unique([guildId, userId])
  @@index([guildId])
}

model ChannelCategory {
  id        String    @id @default(cuid())
  guildId   String
  guild     Guild     @relation(fields: [guildId], references: [id])
  name      String
  position  Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  channels  Channel[]

  @@index([guildId])
}

model Channel {
  id              String           @id @default(cuid())
  type            ChannelType      @default(GUILD_TEXT)
  guildId         String?
  guild           Guild?           @relation(fields: [guildId], references: [id])
  categoryId      String?
  category        ChannelCategory? @relation(fields: [categoryId], references: [id])
  name            String?
  ownerId         String? // GROUP_DM: oluşturan kullanıcı; 1-1 DM + guild kanallarında null
  owner           User?            @relation("ChannelOwner", fields: [ownerId], references: [id])
  ageGated        Boolean          @default(false)
  isPrivate       Boolean          @default(false)
  position        Int              @default(0)
  slowModeSeconds Int              @default(0)
  userLimit       Int              @default(0) // GUILD_VOICE kullanıcı limiti; 0 = sınırsız
  bitrate         Int              @default(64) // GUILD_VOICE ses bit hızı (kbps, 8–96); istemci publish'te uygular
  mediaEnabled    Boolean          @default(false) // C7: admin per-channel kamera/ekran toggle (GUILD_VOICE); default OFF
  readOnly        Boolean          @default(false) // C57: salt okunur metin kanalı; yalnız MANAGE_CHANNELS yazar
  // C9 — 1-1 DM mesaj isteği: null = normal/legacy (kabul edilmiş sayılır); PENDING = istek bekliyor.
  dmRequestStatus DmRequestStatus? // yalnız type=DM
  dmRequesterId   String? // isteği başlatan (PENDING/ACCEPTED-via-request'te dolu)
  dmRequester     User?            @relation("DmRequester", fields: [dmRequesterId], references: [id])
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  messages        Message[]
  members         ChannelMember[]
  channelReads    ChannelRead[]
  voiceSessions   VoiceSession[]
  events          GuildEvent[]

  @@index([guildId])
}

// Ses kanalı T&S audit — append-only (presence DEĞİL, geçmiş).
// §4 davranış örüntüsü tespiti: yetişkin→çok sayıda minör teması sinyali.
// Anlık "şu an kim var" LiveKit room state + WS ile; bu tablo kalıcı geçmiş.
// Sözleşme: contracts/SPRINT_V2_LIVEKIT_CONTRACT.md §B2.
model VoiceSession {
  id        String    @id @default(cuid())
  channelId String
  channel   Channel   @relation(fields: [channelId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  joinedAt  DateTime  @default(now())
  leftAt    DateTime? // webhook participant_left ile set; null = (kayda göre) hâlâ içeride
  createdAt DateTime  @default(now())

  @@index([userId, joinedAt])
  @@index([channelId, leftAt])
}

// R11 — Ses kanalı kalıcı sustur (server-mute). Per-kanal kayıt; mintToken bunu kontrol eder
// → kullanıcı çıkıp tekrar katılsa da susturulmuş kalır. Sözleşme: SPRINT_R11_VOICE_MODERATION_CONTRACT.md.
model VoiceMute {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  guildId   String
  mutedById String
  createdAt DateTime @default(now())

  @@unique([channelId, userId])
  @@index([channelId])
}

model Message {
  id               String            @id @default(cuid())
  channelId        String
  channel          Channel           @relation(fields: [channelId], references: [id])
  authorId         String
  author           User              @relation(fields: [authorId], references: [id])
  content          String
  mentions         String[]          @default([]) // §2: bahsedilen + doğrulanmış userId listesi (tekilleştirilmiş, ≤10)
  mentionsEveryone Boolean           @default(false) // @everyone toplu bahsetme (everyone rolü mentionable ise tüm üyelere bildirir)
  // R15 — bahsedilen ROL id'leri (≤3, everyone rolü HARİÇ; o `mentionsEveryone`e yazılır).
  // 🔴 Üye id'leri AÇILMAZ: rol üyeliği sonradan değişir, mesaja gömülü üye listesi yanlış tarihe
  // donardı. Alıcı kümesi okuma anında çözülür (@everyone'da da aynı karar verilmişti).
  mentionRoles     String[]          @default([])
  replyToId        String?
  replyTo          Message?          @relation("MessageReply", fields: [replyToId], references: [id])
  replies          Message[]         @relation("MessageReply")
  editedAt         DateTime?
  deletedAt        DateTime?
  pinnedAt         DateTime? // null = sabit değil; dolu = sabitlenme zamanı
  pinnedById       String? // sabitleyen userId (scalar — FK/relation YOK, audit/görünüm için)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attachments      Attachment[]
  reactions        MessageReaction[]
  // C35: gelen webhook mesajı. authorId = webhook'u oluşturan üye (hesap verebilirlik insanda, §0.3);
  // görünen kimlik webhookName'den gelir. Normal mesajda üçü de null.
  webhookId        String?
  webhook          Webhook?          @relation(fields: [webhookId], references: [id], onDelete: Restrict)
  webhookName      String? // gönderim anındaki görünen ad (anlık görüntü; username mesaj başına ezilebilir)
  embeds           Json? // C35 §2.5: doğrulanmış embed listesi (yalnız izinli alanlar)
  // E1 (DM E2EE): şifreli mesajda content='' ve mentions=[]; ciphertext opak MLS uygulama mesajı.
  encrypted        Boolean           @default(false)
  ciphertext       Bytes?
  senderDeviceId   String?
  // E4 (franking): şifreli mesajda gönderen taahhüdü = HMAC-SHA256(fk, canon), 32 bayt. Sunucu içeriği
  // görmeden saklar; şikâyette şikâyetçinin ilettiği içerik bununla doğrulanır. Şifresizde null.
  frankingTag      Bytes?

  @@index([channelId, createdAt])
  @@index([channelId, pinnedAt])
}

/// C35: gelen webhook. Token yalnız SHA-256 hash olarak saklanır; silme yumuşak (mesajlar kimliği korur).
model Webhook {
  id                   String                @id @default(cuid())
  guildId              String
  channelId            String
  name                 String
  tokenHash            String
  createdById          String
  createdBy            User                  @relation(fields: [createdById], references: [id])
  deletedAt            DateTime?
  lastUsedAt           DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  messages             Message[]
  kind                 WebhookKind           @default(USER) // C36: STREAM_ANNOUNCE = sistem yönetimli, yürütme ucu her zaman 404
  streamAnnounceConfig StreamAnnounceConfig?

  @@index([channelId])
  @@index([guildId])
}

enum WebhookKind {
  USER
  STREAM_ANNOUNCE
}

// ─── C36: Kick + Twitch hesap bağlama ve "yayına başladı" duyurusu ───────────

enum ExternalProvider {
  KICK
  TWITCH
}

// Dış platform erişim/yenileme token'ı SAKLANMAZ (§2.4): yalnız kimlik + kullanıcı adı.
model ExternalAccount {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  provider        ExternalProvider
  externalId      String
  username        String
  showOnProfile   Boolean          @default(true)
  lastLiveAt      DateTime?
  lastAnnouncedAt DateTime?
  linkedAt        DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([provider, externalId])
  @@unique([userId, provider])
}

// OAuth state (= id), tek kullanımlık, 10 dk ömür.
model ExternalLinkState {
  id           String           @id
  userId       String
  provider     ExternalProvider
  codeVerifier String
  expiresAt    DateTime

  @@index([expiresAt])
}

model StreamAnnounceConfig {
  id            String   @id @default(cuid())
  guildId       String   @unique
  channelId     String
  webhookId     String   @unique
  webhook       Webhook  @relation(fields: [webhookId], references: [id])
  mentionRoleId String?
  enabled       Boolean  @default(true)
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StreamAnnounceOptIn {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([guildId, userId])
  @@index([userId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id])
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId]) // C46: kişi başı mesaj başına TEK tepki
  @@index([messageId])
}

model Attachment {
  id                 String             @id @default(cuid())
  uploaderId         String
  uploader           User               @relation(fields: [uploaderId], references: [id])
  messageId          String? // mesaja iliştirilince set (önce PENDING, presign anında null olabilir)
  message            Message?           @relation(fields: [messageId], references: [id])
  storageKey         String             @unique // S3 objesi anahtarı
  filename           String
  contentType        String
  size               Int
  durationMs         Int? // yalnız ses ekinde dolu (sesli mesaj, M6b)
  waveform           String? // yalnız ses ekinde: 64 örnek (0-255) base64, 88 karakter (M6b §7)
  thumbnail          String? // yalnız video ekinde: küçük resim, base64 JPEG (M6c)
  width              Int? // yalnız video ekinde
  height             Int? // yalnız video ekinde
  scanStatus         ScanStatus         @default(PENDING)
  aiGenerationId     String? // C14b: yapay zeka üretiminden gelen ek (sunucu kaynaklı rozet); aynı üretim çok ek olabilir
  aiGeneration       AiVideoGeneration? @relation(fields: [aiGenerationId], references: [id])
  sourceAttachmentId String? // C30: iletme kopyasının kaynağı (düz alan, ilişki yok); moderasyon kopyaları bulabilsin
  audioNormalizedAt  DateTime? // C32: ses seviyesi eşitleme yapıldıysa dolu (idempotency)
  createdAt          DateTime           @default(now())

  @@index([messageId])
  @@index([aiGenerationId])
  @@index([sourceAttachmentId])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("FriendRequester", fields: [requesterId], references: [id])
  addresseeId String
  addressee   User             @relation("FriendAddressee", fields: [addresseeId], references: [id])
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model ChannelMember {
  id           String    @id @default(cuid())
  channelId    String
  channel      Channel   @relation(fields: [channelId], references: [id])
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  lastReadAt   DateTime?
  clearedAt    DateTime? // G4: kullanıcı DM'i inbox'tan temizledi; mesaj KAYDEDILIR, bu tarihten öncesi gizlenir
  lastReaction Json? // C46 §4b: {actorId, actorUsername, emoji, messageId, at}; DM liste satırı göstergesi
  isAdmin      Boolean   @default(false) // GROUP_DM: kurucunun atadığı yönetici (1-1 DM ve ortamda hep false)
  createdAt    DateTime  @default(now())

  @@unique([channelId, userId])
  @@index([userId])
}

enum DepartureReason {
  LEFT
  REMOVED
}

enum GroupDmEventKind {
  MEMBER_ADDED
  MEMBER_LEFT
  MEMBER_REMOVED
}

// C64: grup DM üyelik olay satırı ("X gruptan ayrıldı"). Message DEĞİL: okunmadı/bildirim/push/lastMessage/şifreleme
// hattına girmez. Üyelik değişikliğiyle AYNI transaction ve AYNI an yazılır (createdAt açıkça verilir).
model GroupDmEvent {
  id        String            @id @default(cuid())
  channelId String
  kind      GroupDmEventKind
  actorId   String? // ekleyen/çıkaran; MEMBER_LEFT'te null
  targetId  String // eklenen/ayrılan/çıkarılan
  createdAt DateTime // üyelik değişikliğiyle aynı an (@default DEĞİL)

  @@index([channelId, createdAt])
}

// C65: geri eklenen üyenin önceki üyelik dönemleri (şifreli mesaj süzgeci dönem aralıklarını görünür sayar).
// Geri eklemede SİLİNMEZ; "Sohbeti sil" ve hesap imhasında silinir.
model GroupDmPastPeriod {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  joinedAt  DateTime // o dönemin ChannelMember.createdAt'i
  leftAt    DateTime // ayrılma/çıkarılma anı (C62 leftAt ile aynı an)

  @@index([channelId, userId])
}

// C62: gruptan ayrılan/çıkarılan üyenin listede kalması ve ayrılana kadarki geçmişi okuması için iz.
// ChannelMember silme davranışı DEĞİŞMEZ; yalnız findMessages + DM listesi bu kayda bakar (R7).
model GroupDmDeparture {
  id        String          @id @default(cuid())
  channelId String
  userId    String
  joinedAt  DateTime // silinen ChannelMember.createdAt (katılım öncesi şifreli filtre için)
  leftAt    DateTime        @default(now())
  reason    DepartureReason
  clearedAt DateTime? // silinen üyeliğin G4 clearedAt'i taşınır
  memberIds String[] // ayrılma anında DİĞER üyeler (liste başlığı/avatarı; sonrası sızmaz)

  @@unique([channelId, userId])
  @@index([userId])
}

model Invite {
  id        String    @id @default(cuid())
  code      String    @unique // kısa, paylaşılabilir, URL-safe (8-char)
  guildId   String
  guild     Guild     @relation(fields: [guildId], references: [id])
  creatorId String
  creator   User      @relation("InviteCreator", fields: [creatorId], references: [id])
  maxUses   Int? // null = sınırsız
  uses      Int       @default(0)
  expiresAt DateTime? // null = süresiz
  deletedAt DateTime? // iptal (revoke)
  createdAt DateTime  @default(now())

  @@index([guildId])
}

// ─── Sprint 4B: Moderasyon Çekirdeği ──────────────────────────────────────────

enum ReportReason {
  SPAM
  HARASSMENT
  MINOR_SAFETY
  VIOLENCE
  CSAM
  SELF_HARM
  OTHER
  EMERGENCY // A4: kullanıcı-başlatımlı acil yardım/panik
}

enum ReportTarget {
  MESSAGE
  USER
  CHANNEL
  GUILD
}

enum ReportStatus {
  OPEN
  TRIAGED
  RESOLVED
  DISMISSED
  ESCALATED
}

enum ModActionType {
  WARN
  MUTE
  KICK
  BAN
  CONTENT_REMOVE
  SHADOW_LIMIT
  MEDIA_REMOVE
}

model Report {
  id              String           @id @default(cuid())
  reporterId      String
  reporter        User             @relation("Reporter", fields: [reporterId], references: [id])
  targetType      ReportTarget
  targetId        String
  reason          ReportReason
  description     String?
  status          ReportStatus     @default(OPEN)
  priority        Int              @default(0)
  // contextSnapshot = yalnız minimal referans (içerik burada TUTULMAZ). E4 (sahip kararı 2026-11-11):
  // mesaj şikâyetlerinde kanıt (hedef + önceki 5 mesaj) `ReportEvidence` satırlarında saklanır;
  // kapanıştan 90 gün sonra (`evidencePurgeAt`) silinir. Eski "KURUL §0: içerik yakalanmaz" kuralı kalktı.
  contextSnapshot Json
  resolvedById    String?
  resolvedBy      User?            @relation("ReportResolver", fields: [resolvedById], references: [id])
  resolvedAt      DateTime?
  evidencePurgeAt DateTime? // E4: resolvedAt + 90 gün; silme işi bu tarih geçen raporların kanıtını siler
  evidence        ReportEvidence[]
  createdAt       DateTime         @default(now())

  @@index([status, priority])
  @@index([targetType, targetId])
}

/// E4: şikâyet kanıtı. Mesaj sonradan silinse de kalır (messageId yalnız referans, FK yok).
/// Ekler referanstır (id/tür/boyut/depolama anahtarı); dosya KOPYALANMAZ.
model ReportEvidence {
  id          String   @id @default(cuid())
  reportId    String
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  messageId   String
  authorId    String?
  channelId   String
  content     String // şifrelide şikâyetçinin ilettiği düz metin; şifresizde sunucunun okuduğu
  attachments Json // [{ id, contentType, size, storageKey }]
  messageAt   DateTime // mesajın createdAt'i
  source      String // 'server' | 'reporter'
  verified    Boolean // server: true; reporter: franking doğrulandıysa true
  isTarget    Boolean // şikâyet edilen mesaj (false = bağlam)
  createdAt   DateTime @default(now())

  @@index([reportId])
}

model ModerationAction {
  id              String        @id @default(cuid())
  moderatorId     String
  moderator       User          @relation("ModeratorActions", fields: [moderatorId], references: [id])
  targetUserId    String
  targetUser      User          @relation("ModerationTargets", fields: [targetUserId], references: [id])
  type            ModActionType
  scope           String? // guildId | null = global
  reason          String
  relatedReportId String?
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())

  @@index([targetUserId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  action     String // "moderation.ban", "moderation.mute", "report.resolve", ...
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}

// ─── Sprint 6.2: Guild Kanal Okunmamış Takibi ────────────────────────────────

model ChannelRead {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  channelId  String
  channel    Channel  @relation(fields: [channelId], references: [id])
  lastReadAt DateTime @default(now())

  @@unique([userId, channelId])
  @@index([userId])
}

// ─── Sprint V3: Ortam Etkinlikleri (Scheduled Events) ────────────────────────
// recurrence/status/coverImageId şema-foresight (sahip onaylı yarın); MVP'de motor YOK.

model GuildEvent {
  id        String @id @default(cuid())
  guildId   String
  guild     Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  creatorId String
  creator   User   @relation("EventCreator", fields: [creatorId], references: [id])

  name        String // "Etkinlik Konusu" (zorunlu)
  description String? // markdown (mevcut markdown render boru hattı)

  locationType     EventLocationType
  channelId        String? // VOICE_CHANNEL ise zorunlu
  channel          Channel?          @relation(fields: [channelId], references: [id], onDelete: SetNull)
  externalLocation String? // EXTERNAL ise zorunlu (metin/konum/link, düz metin)

  startAt DateTime
  endAt   DateTime? // opsiyonel

  recurrence   EventRecurrence @default(NONE) // motor yarın
  status       EventStatus     @default(SCHEDULED) // otomatik geçiş yarın
  coverImageId String? // Attachment (yarın); MVP null

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  interests GuildEventInterest[]

  @@index([guildId, startAt])
}

model GuildEventInterest {
  id        String     @id @default(cuid())
  eventId   String
  event     GuildEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([eventId, userId])
}

model Notification {
  id     String           @id @default(cuid())
  userId String // ALICI
  user   User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType

  actorId String? // tetikleyen (mesaj yazarı / istek gönderen) — User
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  guildId   String? // mention bağlamı (navigasyon)
  channelId String? // mention: zıplama hedefi kanal
  messageId String? // mention: zıplama hedefi mesaj
  preview   String? // mention metni anlık görüntüsü (≤120; mesaj sonradan silinse de kalır)
  aiVideoId String? // C49: AI_VIDEO_* bildirimlerinde üretim kimliği (ilişkisiz; satır soft-delete)

  readAt    DateTime? // null = okunmamış
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPref {
  id                   String            @id @default(cuid())
  userId               String
  user                 User              @relation("UserNotificationPrefs", fields: [userId], references: [id], onDelete: Cascade)
  targetType           NotifTargetType
  targetId             String // GUILD → guildId, CHANNEL → channelId
  muted                Boolean           @default(false)
  mutedUntil           DateTime? // null + muted=true → süresiz; geçmişse mute sona ermiş (bildir)
  level                NotificationLevel @default(ALL)
  // R14 — yalnız targetType=GUILD satırında anlamlı (setPref kanal hedefinde 400 INVALID_PREF_TARGET).
  // Kanal düzeyi bilinçli DIŞARIDA: kayıt-bazlı override zinciri (channelPref ?? guildPref) bastırmayı
  // sessizce geri getirirdi (sözleşme R14 §2.2).
  suppressEveryone     Boolean           @default(false) // @everyone genişlemesinden gelen bildirim/rozet bastırılır
  suppressEvents       Boolean           @default(false) // EVENT_CREATED bildirimi üretilmez
  // R15 — rol genişlemesinden gelen bildirim/rozet bastırılır (doğrudan bahsetme her zaman geçer)
  suppressRoleMentions Boolean           @default(false)
  updatedAt            DateTime          @updatedAt

  @@unique([userId, targetType, targetId])
  @@index([userId])
}

// ─── Sprint M3: Mobil Push Bildirimi ──────────────────────────────────────────
// 🔴 Token KULLANICIYA bağlıdır, CİHAZA değil. Aynı cihazda hesap değişince
// upsert (token @unique üzerinden) userId'yi yeni kullanıcıya taşır — aksi hâlde
// önceki kullanıcının bildirimi yeni kullanıcının cihazına düşer (T&S sızıntısı,
// bkz. SPRINT_M3_MOBILE_PUSH_CONTRACT.md §2.1/§4).

model PushToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique // Expo push token (ExponentPushToken[...])
  platform   String // 'android' | 'ios' — bugün yalnız android yazılır
  deviceName String? // kullanıcıya gösterilmez; teşhis için
  // C50: push biçimi. 1 = bugünkü title/body; 2 = veri-yalnız (istemci bildirimi kendisi çizer).
  format     Int      @default(1)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

// ─── Sprint Closed-Registration: Platform Davet Sistemi ──────────────────────
// KAVRAM: Bu model platform kaydını kapılar (yeni hesap açma).
// Sprint 7A Invite modeli guild/ortam davetidir — iki model birbirinden tamamen bağımsız.

model PlatformInvite {
  id         String    @id @default(cuid())
  code       String    @unique // 8-char URL-safe base32 (short-code.util)
  note       String? // admin memo: kime/niçin verildi (opsiyonel)
  maxUses    Int? // null = sınırsız
  uses       Int       @default(0)
  expiresAt  DateTime? // null = süresiz
  disabledAt DateTime? // soft-iptal (revoke)
  creatorId  String
  creator    User      @relation("PlatformInviteCreator", fields: [creatorId], references: [id])
  redeemers  User[]    @relation("RedeemedPlatformInvite")
  createdAt  DateTime  @default(now())

  @@index([creatorId])
}

// ─── C14: yapay zeka ile video üretimi (yalnız açık liste; kredi/cüzdan yok, yalnız harcama kaydı) ───
enum AiVideoStatus {
  QUOTED
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

/// C40: admin panelinden verilen yapay zeka video erisim hakki (kredi butcesi + istege bagli bitis). Kullanici basina tek kayit.
model AiVideoGrant {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation("AiVideoGrantUser", fields: [userId], references: [id])
  budgetMicroUsd Int
  startsAt       DateTime  @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  grantedById    String
  grantedBy      User      @relation("AiVideoGrantBy", fields: [grantedById], references: [id])
  note           String? // yalniz admin icin; kullaniciya ASLA donmez
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AiVideoGeneration {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id])
  model               String // tam api_id, ör. "pika/pika-2.5/image-to-video"
  prompt              String // <= AI_PROMPT_MAX (10000)
  inputKey            String? // özel bucket: ai-input/{userId}/{uuid}.{ext}; yalnız görselden üretimde
  references          Json? // C42: [{ kind: image|video|audio, key }] sırasıyla; null = referans yok
  resolution          String // "720p"
  durationS           Int // 5
  aspectRatio         String? // C14f: "16:9"; null = Otomatik (alan sağlayıcıya gönderilmez)
  quoteMicroUsd       Int // gönderim öncesi teklif
  costMicroUsd        Int? // Pika billing.state=settled olunca
  providerJobId       String? // Pika "media_..." id
  status              AiVideoStatus @default(QUOTED)
  errorCode           String? // Pika error.code ya da bizim kodumuz
  outputKey           String? // özel bucket: ai-video/{userId}/{id}.mp4
  createdAt           DateTime      @default(now())
  completedAt         DateTime?
  providerCompletedAt DateTime? // Pika completed gorulen an (indirme 24 sa sayaci)
  deletedAt           DateTime? // yumusak silme: satir harcama kaydi olarak kalir
  attachments         Attachment[]

  @@index([userId, createdAt])
  @@index([status])
}

// ─── E1: 1-1 DM uçtan uca şifreleme (MLS). Sunucu içerik görmez; yalnız sırayı tutar ───
// Sözleşme: contracts/SPRINT_E1_DM_E2EE_CONTRACT.md §2.1 (Rev.2: cihaz oturum ZİNCİRİNE bağlı)

model E2eeDevice {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenFamily  String?          @unique // refresh rotasyonunda sabit; zincir bitince cihaz iptal (§2.6). C69: çıkışta null (park)
  platform     String // 'web' | 'android'
  signatureKey Bytes // MLS leaf imza açık anahtarı (Ed25519, 32 bayt)
  createdAt    DateTime         @default(now())
  lastSeenAt   DateTime         @default(now())
  revokedAt    DateTime?
  parkedAt     DateTime? // C69: çıkışla park edildi (iptal DEĞİL); yeniden bağlanınca null, 30 gün sonra işle iptal
  keyPackages  E2eeKeyPackage[]

  @@index([userId])
  @@index([parkedAt])
}

/// C69: park edilmiş cihazı yeniden bağlama meydan okuması. Tek kullanımlık, kısa ömürlü; sır değil (imzalanacak rastgele değer).
model E2eeRebindNonce {
  id        String   @id @default(cuid())
  userId    String
  nonce     Bytes    @unique // 32 bayt rastgele
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model E2eeKeyPackage {
  id         String     @id @default(cuid())
  deviceId   String
  device     E2eeDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  data       Bytes // serileştirilmiş KeyPackage (opak)
  lastResort Boolean    @default(false)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([deviceId, consumedAt])
}

model E2eeGroup {
  channelId   String   @id // 1 kanal = 1 MLS grubu
  groupId     Bytes // MLS group_id (istemci üretir, 32 bayt rastgele)
  epoch       Int // sunucunun kabul ettiği son epoch
  createdById String // ilk grubu kuran cihaz (deviceId)
  createdAt   DateTime @default(now()) // ayraç zamanı
}

/// E2: şifreli GROUP_DM'den ayrılan/çıkarılan üye. Eski üyenin MLS yaprakları grupta kaldığı sürece doğrulama onları tanımalı.
model E2eeFormerMember {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  leftAt    DateTime @default(now())

  @@unique([channelId, userId])
  @@index([channelId])
}

model E2eeHandshake {
  id             String   @id @default(cuid())
  channelId      String
  epoch          Int // bu commit'in uygulandığı epoch (kabulden önceki değer)
  senderDeviceId String
  commit         Bytes // opak MLS commit
  createdAt      DateTime @default(now())

  @@unique([channelId, epoch])
}

model E2eeWelcome {
  id             String    @id @default(cuid())
  channelId      String
  epoch          Int // cihazın katılacağı epoch
  targetDeviceId String
  welcome        Bytes // opak MLS Welcome (ağaç içinde, ratchet_tree uzantısı)
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([targetDeviceId, deliveredAt])
}

/// E5a: şifreli DM yedeği anahtar kaydı. Sunucu yalnız tuz, parametre ve SARILMIŞ anahtarı tutar; yedek şifresi cihazdan çıkmaz.
model E2eeBackup {
  userId     String   @id
  salt       Bytes // 16
  params     Json // { m, t, p } Argon2id
  wrappedKey Bytes // nonce(12) + AES-GCM çıktısı (60 bayt)
  keyVersion Int // sıfırlamada artar
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// E5a: cihaz başına şifreli yerel mesaj görüntüsü (nesne özel bucket'ta). deviceId iptal edilse de KALIR (kayıp telefonun geçmişi).
/// Bilerek User ilişkisi yok (sözleşme §3.1); hesap imhasında purge.job nesne + satırı açıkça siler.
model E2eeBackupSnapshot {
  id         String   @id @default(cuid())
  userId     String
  deviceId   String // E2eeDevice.id
  keyVersion Int
  objectKey  String // e2ee-backup/{userId}/{deviceId}/{sha256}
  size       Int
  sha256     String
  updatedAt  DateTime @updatedAt

  @@unique([userId, deviceId])
  @@index([userId])
}

/// E5b: cihazdan cihaza geçmiş aktarımı. Sunucu yalnız taahhüdü, geçici açık anahtarları ve şifreli yükü taşır;
/// düz metin, ortak sır, kod görmez. 10 dk ömür; bitmiş satırlar 7 gün sonra silinir. User ilişkisi yok
/// (hesap silme anonimleştirir; purge açıkça siler, görüntü tablosuyla aynı).
enum E2eeTransferStatus {
  PENDING
  ACCEPTED
  REVEALED
  UPLOADED
  DONE
  CANCELLED
  EXPIRED
}

model E2eeTransfer {
  id          String             @id @default(cuid())
  userId      String
  newDeviceId String // isteği açan yeni cihaz (N)
  oldDeviceId String? // kabul eden eski cihaz (O)
  commit      Bytes // SHA256 taahhüdü (32)
  newPub      Bytes? // N'nin geçici X25519 açık anahtarı, reveal'da
  newNonce    Bytes? // taahhüt rastgeleliği (32), reveal'da
  oldPub      Bytes? // O'nun geçici açık anahtarı, accept'te
  objectKey   String? // e2ee-transfer/{userId}/{id}
  size        Int?
  sha256      String?
  status      E2eeTransferStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  expiresAt   DateTime

  @@index([userId, status])
  @@index([expiresAt])
}
