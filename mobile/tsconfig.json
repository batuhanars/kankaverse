{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@modules/*": [
        "./modules/*"
      ],
      "@kankaverse/e2ee-core": [
        "../shared/e2ee-core/src/index.ts"
      ],
      "@kankaverse/e2ee-client": [
        "../shared/e2ee-client/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "tests"
  ]
}
