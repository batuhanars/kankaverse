# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Firebase servis hesabı anahtarı (gizli — FCM V1 push için EAS credentials'a yüklenir,
# repoya ASLA girmez). google-services.json bunun DIŞINDA — herkese açık istemci
# tanımlayıcıları taşır, bilinçli olarak commit'lenir (bkz. M3 sözleşmesi §5).
*serviceAccount*.json
*service-account*.json
# 🔴 Desen BAŞTAN eşleşmeye çalışmamalı: Firebase'in verdiği gerçek ad
# "<proje>-firebase-adminsdk-<hash>.json" biçiminde, yani "firebase-adminsdk-*" ile
# BAŞLAMIYOR. İlk yazımda öyleydi ve dosya ignore edilmiyordu (2026-08-03 yakalandı).
*firebase-adminsdk*.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# i18n — üretilmiş kopya (contract §6 kaçış yolu). Tek doğruluk kaynağı: ../web/src/i18n/tr.json
src/i18n/tr.generated.json

# 🔴 Istisna: `.env.production` depoya GIRER. Kok .gitignore `.env.*` diyor, burada geri aliniyor.
# Icinde sir yok, yalniz canli adresler var. Olmazsa yerel `gradlew bundleRelease` `.env`deki
# LAN IP'sini gomer ve testcinin telefonunda hicbir sey calismaz (eas.json'daki env YALNIZ EAS
# bulut derlemesinde gecerlidir). Sessiz ve pahali bir hata sinifi; dosya bu yuzden paylasiliyor.
!.env.production
